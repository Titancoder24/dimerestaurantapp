{
  "expo": {
    "name": "DIME",
    "slug": "dime",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "dime",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FC8019"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dime.app",
      "infoPlist": {
        "NSCameraUsageDescription": "DIME uses the camera to scan table QR codes at restaurants.",
        "NSPhotoLibraryUsageDescription": "DIME uses your photos so you can attach images to reviews.",
        "NSCalendarsUsageDescription": "DIME adds your table reservations to your calendar."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FC8019"
      },
      "package": "com.dime.app",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow DIME to access your camera to scan QR codes."
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
